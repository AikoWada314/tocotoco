// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ユーザー管理 ---

model User {
  id             Int      @id @default(autoincrement())
  supabaseUserId String   @unique @map("supabase_user_id")
  name           String
  nickname       String?
  userId         String?  @unique @map("user_id")
  iconUrl        String?  @map("icon_url")
  bio            String?
  role           String
  status         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  posts             Post[]
  postLikes         PostLike[]
  spotsCreated      Spot[]             @relation("SpotCreator")
  spotReviews       SpotReview[]
  eventsCreated     Event[]            @relation("EventCreator")
  userNotifications UserNotification[]
  postFavorites     PostFavorite[]
  spotFavorites     SpotFavorite[]
  eventFavorites    EventFavorite[]
  postComments PostComment[]

  @@map("users")
}

// --- つぶやき機能 ---

model Post {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  content    String
  categoryId Int      @map("category_id")
  isDraft    Boolean  @map("is_draft")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  PostCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images    PostImage[]
  likes     PostLike[]
  favorites PostFavorite[]

  comments PostComment[]

  @@map("posts")
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_images")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}


model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  content   String
  imageUrl String? @map("image_url")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

model PostCategory {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("post_categories")
}

// --- スポット情報 ---

model Spot {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  address     String
  lat         Float
  lng         Float
  categoryId  Int      @map("category_id")
  createdBy   Int      @map("created_by")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  SpotCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  creator   User           @relation("SpotCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  images    SpotImage[]
  reviews   SpotReview[]
  favorites SpotFavorite[]

  @@map("spots")
}

model SpotImage {
  id        Int      @id @default(autoincrement())
  spotId    Int      @map("spot_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("spot_images")
}

model SpotCategory {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spots Spot[]

  @@map("spot_categories")
}

// --- 口コミ機能 ---

model SpotReview {
  id        Int      @id @default(autoincrement())
  spotId    Int      @map("spot_id")
  userId    Int      @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spot   Spot          @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ReviewImage[]

  @@map("spot_reviews")
}

model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review SpotReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

// --- イベント管理 ---

model Event {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  eventDate     DateTime @map("event_date")
  eventEndDate  DateTime? @map("event_end_date")
  place         String
  lat           Float
  lng           Float
  organizerName String   @map("organizer_name")
  organizerLink String?  @map("organizer_link")
  createdBy     Int      @map("created_by")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator   User            @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  images    EventImage[]
  favorites EventFavorite[]

  @@map("events")
}

model EventImage {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_images")
}

// --- 通知機能 ---

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userNotifications UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  notificationId Int      @map("notification_id")
  isRead         Boolean  @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("user_notifications")
}

// --- お気に入り ---

model PostFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_favorites")
}

model SpotFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  spotId    Int      @map("spot_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@unique([userId, spotId])
  @@map("spot_favorites")
}

model EventFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_favorites")
}
